{
  "hosting": {
    "public": "web",
    "ignore": [
      "**/.*",
      "config.example.js"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html|json|md)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}